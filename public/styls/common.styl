
button, a 
    cursor pointer
    outline none
    background transparent 
    border none
    font-size 1rem
    color alpha + 20%
    padding .6rem
* 
    box-sizing border-box   
    margin 0
    padding 0
    color alpha + 20%

h1, h2, h3, h4, h5, h6
    position relative
    text-transform: uppercase
    font-weight 400
    font-size 1rem
    color alpha + 20%
h1 
    font-size 1.4rem
p.subtitle 
    line-height 1
    top -.4rem
::-webkit-scrollbar 
    width 10px;
    border-radius 5px

/* Track */
::-webkit-scrollbar-track 
    //background: alpha - 40%;


/* Handle */
::-webkit-scrollbar-thumb 
    background: alpha
    border-radius 5px



/* Handle on hover */
.scroller::-webkit-scrollbar-thumb:hover 
    background: alpha + 20%;
.light-border
    border 1px solid rgba(alpha, .16)

.game-message
    font-size 1.1rem
    color alpha + 20%
    padding .4rem
    text-align center
    background alpha - 55%


.pos-rel
    position relative
.pos-abs
    position absolute    

.txt-center
    text-align center
.txt-left
    text-align left
.txt-right
    text-align right