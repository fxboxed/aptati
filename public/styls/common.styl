
button, a 
    cursor pointer
    outline none
    background transparent 
    border none
    font-size 1rem
    color alpha + 20%
    padding .6rem
* 
    box-sizing border-box   
    margin 0
    padding 0
    color alpha + 20%

h1, h2, h3, h4, h5, h6
    position relative
    text-transform: uppercase
    font-weight 400
    font-size 1rem
    color alpha + 80%
h1 
    font-size 1.2rem
p
    color alpha + 80%
p.used-unused
    display flex
    gap 1rem
    justify-content center
    align-items center
    .used-letters
        color gamma
    .unused-letters
        color beta
.dot
    width 8px
    height 8px
    border-radius 50%
    background alpha + 20%
p.subtitle 
    line-height 1
    top -.4rem
::-webkit-scrollbar 
    width 10px;
    border-radius 5px
/* Track */
::-webkit-scrollbar-track 
/* Handle */
::-webkit-scrollbar-thumb 
    background: alpha
    border-radius 5px



/* Handle on hover */
.scroller::-webkit-scrollbar-thumb:hover 
    background: alpha + 20%;
.light-border
    border 1px solid rgba(alpha, .16)

.guide
    padding 0 .5rem
    border-left 6px solid epsilon - 40%
    p.guide-p
        text-transform normal !important
        color epsilon + 40%
        text-align left
p.hint 
    color epsilon 
    font-size 1rem
    //text-align left
    //border-left 4px solid
    //padding-left 1rem
    height fit-content
    line-height 1
    margin 0 auto
    width fit-content
    text-align center
    //border 1px solid green
.custom-hr 
    display flex
    gap .5rem
    justify-content center
    align-items center
    margin 1rem auto
    width fit-content
    ///border 1px solid #fff
    .span-1, .span-3
        min-width 6rem
        height 1px
        background rgba(alpha, .4)
        //width 100%

.pos-rel
    position relative
.pos-abs
    position absolute    
.txt-center
    text-align center
.txt-left
    text-align left
.txt-right
    text-align right