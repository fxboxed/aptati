

* 
    box-sizing border-box   
    margin 0
    padding 0
    color alpha + 20%

button, a 
    cursor pointer
    outline none
    background transparent 
    display flex
    justify-content center 
    align-items center
    border none
    font-size .9rem
    color alpha + 40%
    padding .2rem .3rem
    text-decoration none
    text-transform uppercase

h1, h2, h3, h4, h5, h6
    position relative
    text-transform: uppercase
    font-weight 400
    font-size 1rem
    color alpha + 80%

p
    color alpha + 80%
p.used-unused
    display flex
    gap 1rem
    justify-content center
    align-items center
    .used-letters
        color gamma
    .unused-letters
        color beta
.dot
    width 8px
    height 8px
    border-radius 50%
    background alpha + 20%
p.subtitle 
    line-height 1
    top -.4rem
::-webkit-scrollbar 
    width 10px;
    border-radius 5px
    display none
