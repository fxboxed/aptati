.light-border
    border 1px solid rgba(alpha, .16)

.guide
    padding 0 .5rem
    border-left 6px solid epsilon - 40%
    p.guide-p
        text-transform normal !important
        color epsilon + 40%
        text-align left
p.hint 
    color epsilon 
    font-size 1rem
    //text-align left
    //border-left 4px solid
    //padding-left 1rem
    height fit-content
    line-height 1
    margin 0 auto
    width fit-content
    text-align center
    //border 1px solid green
.custom-hr 
    display flex
    gap .5rem
    justify-content center
    align-items center
    margin 1rem auto
    width 100% // fit-content
    ///border 1px solid #fff
    .span-1, .span-3
        min-width 6rem
        height 1px
        background rgba(alpha, .4)
        //width 100%
hr.plain-hr
    width 100%
    height 1px
    //background red //rgba(alpha, .4)  
.pos-rel
    position relative
.pos-abs
    position absolute    
.txt-center
    text-align center
.txt-left
    text-align left
.txt-right
    text-align right
