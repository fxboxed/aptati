
.bl-game-block
    width 90% !important
    //margin 1rem auto
    width: 100%
    height: 18rem !important
    max-width 85%
    //margin: 1rem auto 0rem
    display: grid
    grid-template-columns: repeat(3, 1fr)
    gap: 1rem
    justify-content: space-between
    p
        font-size .9rem


.bl-words-used-box
    position absolute 
    left: 50%
    top 9.8rem 
    transform translate(-50%, -50%)
    height 8.4rem
    width: 68% !important
    flex 1
    z-index: 5
    text-align center
    //border: 1px solid rgba(alpha, 0.3)
    border-radius: 8px
    padding: 0.5rem

.bl-side
    display: flex
    justify-content: center
    position relative
    &.top
        position absolute
        top 0
        left 50%
        transform translate(-50%,0)
        order: 1
        margin 0 auto
        margin-bottom: 1rem
        gap: 0.5rem
        height fit-content
    &.left
        width: auto
        order: 2
        flex-direction: column
        gap: 0.5rem
        margin-top 4rem
        position absolute 
        top 0
        left 0
    &.right
        width: auto
        order: 3
        flex-direction: column
        margin-top 4rem
        gap: 0.5rem
        position absolute
        top 0
        right 0
    &.bottom
        position absolute
        bottom 0
        left 50%
        transform translate(-50%,0)
        order: 4
        margin 0 auto
        margin-top: 1rem
        gap: 0.5rem
        height fit-content

.letter-btn
    width: 48px
    max-width: 48px
    height: 48px
    position relative
    z-index 0
    border 1px solid rgba(beta, .2)
    border-radius: 8px
    font-size: 1.5rem
    font-weight: normal
    color: beta + 20%
    cursor: pointer
    display: flex
    align-items: center
    justify-content: center
    transition: all 0.2s
    &:hover
        background: rgba(delta, 0.4)
        transform: scale(1.02)

p.words-used-title
    margin -2rem auto 0 !important
    padding-bottom .6rem

.solve-in-words
    margin .4rem auto
    position relative
    bottom 0rem
    margin-bottom .2rem !important

p,span
    text-align: center
    font-size: 1rem
    font-weight: normal
    margin 0
    background transparent

#bl-word-list
    background:rgba(alpha, 0.1)
    display flex
    flex-wrap: wrap
    justify-content: center
    align-items start
    gap: 0.4rem

    border-radius: 4px
    padding: 0.5rem
    height 7rem !important

    margin 0 auto !important

    width 100% !important
    .word-item
        display: flex
        align-items: center
        justify-content: center
        padding: 0.2rem 0.8rem
        margin: 0.2rem
        height 1.2rem
        font-size: 0.8rem
        color: beta