.cq-toggle
    background: transparent
    border 1px solid rgba(alpha, 0.5)
    border-radius: 6px
    padding: 0.5rem 1rem
    font-size: 0.9rem
    cursor pointer
    transition: all 0.2s ease
    width fit-content //90%
    color alpha + 60%
    font-weight bold
    &:hover
        background: rgba(alpha, 0.5)
    &:focus
        transform: scale(0)
.words-grid
    display flex
    flex-wrap wrap
    grid-template-columns: repeat(4, 1fr)
    gap: 0.5rem
    color: beta
    //font-size 1rem
    //margin 0rem auto 1.5rem
    width 100%
    //position relative
    //z-index 0

    button.word-tile
        border 1px solid rgba(beta, 0.30)
        //background: red //alpha - 80%
        cursor pointer
        padding: 0.5rem 1rem
        width fit-content // 100%
        font-size: 0.7rem
        transition: all 0.3s ease
        min-width 22%
        flex 1


        &.selected
            background: rgba(beta, 0.1)
            backdrop-filter: blur(10px)
            -webkit-backdrop-filter: blur(10px) /* Safari support */

