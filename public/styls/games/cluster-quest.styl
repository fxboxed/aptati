#cq-found-categories
    background transparent
    button
        flex: 1
        //padding: 0.7rem
        border: none
        border-radius: 6px
        font-size: .9rem
        cursor: pointer
        transition: all 0.2s ease
        text-transform: uppercase
        color: beta
        border: 1px solid rgba(alpha, 0.5)
        position relative
        //z-index 0
        //background: rgba(alpha, 0.3)
        &:hover
            background: rgba(alpha, 0.5)
        &:active
            transform: scale(0.95)


