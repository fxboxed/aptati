    border-radius: 6px
    padding: 0.5rem
    text-align: center
    min-height: 2rem
    display flex
    align-items center
    justify-content center
    //transition: background-color 0.3s ease;   /* only background color fades */
    pointer-events none
.cq-answer-1, .cq-found-categories

    background: rgba(alpha, 0.2)

.cq-answer-2, .cq-found-categories 
    background: rgba(gamma, 0.2)

.cq-answer-3, .cq-found-categories 
    background: rgba(epsilon, 0.2)

.cq-answer-4, .cq-found-categories 

