        display: flex
        align-items: center
        justify-content: center
        cursor: pointer
        z-index: 100
        font-size: 1rem
        padding .4rem
        //background: rgba(delta, 0.3)
        border 1px solid alpha - 40%
        border-radius: 8px
        width 120px
