// alpha = #2d7f9d
// beta = #FACE68
// gamma = #007f00
// delta = #dc7684
// epsilon = #896C6C 

.word-grid
    display: flex
    flex-direction: column
    gap:6px
    width: 100%
    max-width 70%
    height: fit-content
    //padding: 0.4rem
    margin .6rem auto
    //border 1px solid #fff

    .tile-row
        display flex
        gap 6px
        width 100%
        position relative

    .tile
        height: 2.8rem //auto
        aspect-ratio: 1 / 1
        width: 2.4rem !important
        display: flex
        flex: 1
        gap: 1rem
        justify-content: center
        align-items: center
        font-size: 1.8rem
        font-weight: bold
        text-transform: uppercase
        border: 1px solid rgba(alpha, 0.4)
        border-radius: 4px
        transition: all 0.3s ease
        color: alpha + 50%
            

.keyboard
    display: flex
    flex-direction: column
    gap: 0.4rem
    padding: .1rem 0.4rem
    width: 100%
    box-sizing: border-box




    .key-row
        display: flex
        gap: 0.1rem
        width: 100%
        position: relative
        justify-content: center

        .key
            //background: rgba(beta, .2)
            border 1px solid alpha - 40%
            border-radius: 4px
            flex: 1
            height: 36px
            display: flex
            justify-content: center
            align-items: center
            font-size: 1.1rem
            font-weight: bold
            text-transform: uppercase
            cursor: pointer
            user-select: none
            color: beta
            transition: all 0.2s ease            
            &.enter
                background: darken(gamma, 60%)
                flex: 1.5
                text-transform: none
                font-size: 1.3rem
            
            &.backspace
                background: darken(delta, 60%)
                flex: 1.2
                text-transform: none
                font-size: 1.1rem
    
    .enter-backspace-row
        gap: 0.1rem
        
        .key
            min-height: 44px
            height 40px
            font-size: 1rem
            
            &:not(.enter):not(.backspace)
                flex: 1
                font-size: 1rem
            
            &.enter, &.backspace
                flex: 1.1
                font-size: 1.2rem

// Tempoary classes to be added to the games by JS for styling purposes. Do not style any elements in the JS, only add classes to elements. Do not assign any styles, inline or otherwise.
.ws-correct
    background: gamma - 70%
    color: alpha + 60%
.ws-present
    background: theta - 50%
    color: alpha + 60%
.ws-incorrect
    background: delta - 60%
    color: alpha + 60%
span.ws-answer
    font-size: 1.2rem
    color: beta + 20%
    //margin 
    width 100%
    text-align center
    border 1px solid alpha - 40%
    display: inline-block