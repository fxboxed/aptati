// =========================================================================
// COLOR PALETTE DEFINITIONS
// =========================================================================
alpha = #2d7f9d
beta = #FACE68
gamma = #007f00
delta = #dc7684
epsilon = #896C6C
theta = #d4ac0d // Added missing fallback variable for ws-present

// =========================================================================
// WORD GRID STYLES
// =========================================================================
.word-grid
    display: flex
    flex-direction: column
    gap: 6px
    width: 100%
    max-width: 70%
    height: fit-content
    margin: 0.6rem auto

    .tile-row
        display: flex
        gap: 6px
        width: 100%
        position: relative

    .tile
        height: 2.8rem
        aspect-ratio: 1 / 1
        width: 2.4rem !important
        display: flex
        flex: 1
        gap: 1rem
        justify-content: center
        align-items: center
        font-size: 1.8rem
        font-weight: bold
        text-transform: uppercase
        border: 1px solid rgba(alpha, 0.4)
        border-radius: 4px
        transition: all 0.3s ease
        background-color: #1a1a1a // Solid dark background default
        color: lighten(alpha, 60%) // Clean high-contrast neutral text

// =========================================================================
// KEYBOARD STYLES
// =========================================================================
.keyboard
    display: flex
    flex-direction: column
    gap: 0.4rem
    padding: 0.1rem 0.4rem
    width: 100%
    box-sizing: border-box

    .key-row
        display: flex
        gap: 0.1rem
        width: 100%
        position: relative
        justify-content: center

        .key
            background-color:  #2a2a2a // Solid key background
            border: 1px solid darken(alpha, 40%)
            border-radius: 4px
            flex: 1
            height: 36px
            display: flex
            justify-content: center
            align-items: center
            font-size: 1.1rem
            font-weight: bold
            text-transform: uppercase
            cursor: pointer
            user-select: none
            color: #ffffff // Crisp white key labels
            transition: all 0.2s ease            
            
            &.enter
                background-color: darken(gamma, 40%)
                flex: 1.5
                text-transform: none
                font-size: 1.3rem
                color: #ffffff
            
            &.backspace
                background-color: darken(delta, 40%)
                flex: 1.2
                text-transform: none
                font-size: 1.1rem
                color: #ffffff
    
    .enter-backspace-row
        gap: 0.1rem
        
        .key
            min-height: 44px
            height: 40px
            font-size: 1rem
            
            &:not(.enter):not(.backspace)
                flex: 1
                font-size: 1rem
            
            &.enter, &.backspace
                flex: 1.1
                font-size: 1.2rem

// =========================================================================
// DYNAMIC GAME STATE CLASSES (APPLIED VIA JS)
// =========================================================================
.ws-correct
    background-color: gamma + 20% !important
    border-color: gamma !important
    color: #ffffff !important

.ws-present
    background-color: theta - 40% !important
    border-color: theta !important
    color: #ffffff !important

.ws-incorrect
    background-color: delta !important // #3a3a3c !important
    border-color: delta !important
    color: #fff !important

span.ws-answer
    font-size: 1.2rem
    color: lighten(beta, 20%)
    width: 100%
    text-align: center
    border: 1px solid darken(alpha, 40%)
    display: inline-block