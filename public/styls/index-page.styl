.site-info
    position relative
    margin 0rem auto 1rem
    padding 1rem
    display grid
    justify-content center
    align-items center
    grid-template-columns: 1fr
    grid-template-rows: 1fr
    transform perspective(1200px) rotateX(14deg)
    transform-origin center center
    //box-shadow 0 18px 32px rgba(0,0,0,.24)
    &::before
        content ''
        position absolute
        left 0
        right 0
        bottom -12px
        height 18px
        background rgba(0,0,0,.22)
        //filter blur(22px)
        border-radius 50%
