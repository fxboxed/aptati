//public/styls/main-layout.styl
body 
    display flex
    align-items center
    justify-content center
    min-height 100vh
    background #36454F //linear-gradient(alpha - 40%, alpha) 

body
        background-color #36454F
        background-image radial-gradient(
                ellipse at 50% 45%,
                alpha + 40% 0%,
                alpha + 20% 30%,
                alpha 65%,
                alpha - 10% 100%
        )
        background-attachment fixed
        background-repeat no-repeat
        min-height 100vh
.body-image-wrap
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    overflow hidden

.body-image
    width 100%
    height 100%
    object-fit cover
    opacity .06
.body-liner-grid
    display grid
    grid-template-columns: 1fr
    grid-template-rows 1fr
    //width 100%
    //border 1px solid red
    width 420px

.body-liner
    grid-column 1/2
    grid-row 1/ 2
    width 100%
    max-width 100%
    position relative
    transition: all .3s ease-in-out
    min-height 48rem
    margin 0 auto
    //background pink
// body liner is not removed it is overlaid with 
.nav-body-liner
    order 4
    z-index 1
.main-body-liner 
    transform scale(1,1)    
    //background alpha - 45%
.contact-body-liner
    z-index 2

    &::before
        content ""
        position absolute
        top 0
        left 0
        right 0
        bottom 0
        //background-color: red // rgba(0,0,0,0.6) 
        backdrop-filter: blur(8px);
        z-index - 2
.blur-body-liner
    order 1
    display flex
    justify-content center
    align-items center
    transform scale(1, 0)
    //background-color: red // rgba(0,0,0,0.3); /* Transparency is required */
    backdrop-filter: blur(10px);
    width 100%
    position relative
.blur-body-liner.blur-active
    order 1
    transform scale(1, 1)
    z-index 2
    width 100%
.game-blocks
    width 100%
    height 100%
    max-height 700px
    //max-width 90%
    display flex
    flex-direction column
    justify-content center
    align-items start
    margin 1rem auto
    //border 1px solid rgba(alpha + 60%, .5)
    //width 400px
    .flex-box 
        //height 4rem
        width 100%
        //background green
        flex-grow: 2
        //margin-bottom 2rem
.game-block
    position relative
    width 100%
    height fit-content
    //border 1px solid red
.game-block.header-btns-block
    width 100%