.footer-btns
    display flex
    gap .4rem
    width 100%
    justify-content space-between
    position relative

    //border 1px solid red
  button.footer-btn
    // linear-gradient(90deg, rgba(alpha,.01) 30%, rgba(alpha,.6))
    //border-right 4px solid alpha + 10%
    flex-grow 1
    white-space nowrap

.game-footer
    //border 1px solid blue
    display grid
    grid-template-columns 1fr
    grid-template-rows 1fr
    gap 1rem
    justify-content center
    align-items center
    min-height 4rem
    //margin-bottom -1rem
    .game-message-wrap
        //border 1px solid red
        height 6rem
        width 5rem
.game-message
    color alpha + 80%
    border 1px solid alpha - 40%
    font-size 1rem
    text-align center
    grid-column 1 / 2
    grid-row 1 / 2
    transform scale(1, 0) // Hidden by default
    transition all .3s ease
    transform-origin center
    height 3rem
    visibility hidden

    &.active-state
        transform scale(1, 1) // Visible when active
        visibility visible

.footer-btns
    grid-column 1 / 2
    grid-row 1 / 2
    display flex
    justify-content center
    align-items center
    gap 0.5rem
    transform scale(1, 1) // Visible by default
    transition all .3s ease
    transform-origin center
    visibility visible

    &.hidden-state
        transform scale(1, 0) // Collapses away when a message triggers
        visibility hidden
