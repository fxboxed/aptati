
.answer-reveal
    font-size 1rem
    color alpha + 60%
    text-align center
    margin-bottom 0 //.6rem
    border 1px solid alpha - 40%
.dropdown
  position absolute
  top 0rem
  left - 1%
  right - 1%
  border 1px solid alpha - 40%
  padding 3rem 1rem 1rem
  transform scale(1, 0)
  transition all .3s ease
  transform-origin top  
  z-index 10
  &::after
    content 'X'
    position absolute
    top .5rem
    right .5rem
    font-size 2rem
  &::before
    content ''
    position absolute
    top 0
    left 50%
    transform translateX(-50%)
    width 98%
    height 100%

.header-btn-3:focus + .dropdown
    background: alpha - 50%
    //width 100%
    height 38rem
    transform scale(1, 1)

