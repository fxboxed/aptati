.dropdown
  position absolute
  top 0rem
  left - 1%
  right - 1%
  border 1px solid alpha - 40%
  padding 3rem 1rem 1rem
  transform scale(1, 0)
  transition all .3s ease
  transform-origin top  
  z-index 1000
  &::after
    content 'X'
    position absolute
    top .5rem
    right .5rem
    font-size 2rem
    
  &::before
    content ''
    position absolute
    top 0
    left 50%
    transform translateX(-50%)
    width 98%
    height 100%
    background-color: rgba(0,0,0,0.3) //rgba(255, 255, 255, 0.3); /* Transparency is required */
    backdrop-filter: blur(8px);
    z-index -1
.header-btn-2:focus + .dropdown
    //background: alpha - 50%
    //width 100%
    height 37rem
    transform scale(1, 1)

