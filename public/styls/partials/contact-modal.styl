// Show modal
#contactModal.show
    opacity 1
    transform scale(1, 1) 
    transform-origin: top;
    transition: all .3s ease-in-out
    //display block
    //ransform: translateX(500px) rotate(15deg);
    //display none

.contact-text-area 
    min-height 200px

// Form elements
#contactModal input,
#contactModal textarea
    background rgba(0,0,0, .1) //transparent
    border 1px solid rgba(255, 255, 255, 0.2) //alpha - 40% 
    border-radius 4px
    color alpha + 95%
    font-size 14px
    margin-bottom 10px
    outline none
    padding 10px
    width 100%
 
.button-row  
    display flex
    gap 2rem
    justify-content center //space-between
    margin 0 auto
    width fit-content
    button.send-email
        //: blue // rgba(gamma, 0.3)
        color gamma 
        border 1px solid rgba(gamma, .8)
        &:hover
            background: rgba(gamma, 0.5)
    button#closeModal
        background: rgba(delta, 0.3)

        &:hover
            background: rgba(delta, 0.5)

