


.responsive-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(340px, 1fr))
  gap 1rem
  margin 2rem auto
  position relative
  // transform perspective(1200px) rotateX(-14deg)
  // transform-origin center center

  .responsive-grid-item
    display grid
    grid-template-columns 112px 1fr
    gap .9rem
    align-items stretch
    min-height 112px
    padding .8rem
    text-decoration none
    background linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.02))
    border 1px solid rgba(alpha, .16)
    border-radius 14px
    box-shadow 0 8px 24px rgba(0,0,0,.12)
    transition transform .18s ease, box-shadow .18s ease, border-color .18s ease, background .18s ease
    position relative
    overflow hidden

    &:hover
      transform translateY(-2px)
      box-shadow 0 14px 30px rgba(0,0,0,.18)
      border-color rgba(beta, .38)
      background linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.028))

      .img img
        transform scale(1.03)

      h3
        color lighten(beta, 12%)

      p.card-para
        color rgba(#fff, .82)

      .card-link
        color lighten(alpha, 18%)

    &:focus-visible
      outline none
      border-color beta
      box-shadow 0 0 0 3px rgba(beta, .16), 0 14px 30px rgba(0,0,0,.18)

    .img
      width 112px
      height 112px
      border-radius 10px
      overflow hidden
      background rgba(alpha, .08)
      box-shadow inset 0 0 0 1px rgba(255,255,255,.06)

      img
        display block
        width 100%
        height 100%
        object-fit cover
        transition transform .25s ease

    .txt
      display flex
      flex-direction column
      justify-content center
      min-width 0

    h3
      margin 0 0 .35rem
      font-size 1rem
      line-height 1.2
      font-weight 700
      letter-spacing .01em
      color rgba(#fff, .94)
      text-transform uppercase

    p.card-para
      margin 0
      font-size .92rem
      line-height 1.5
      text-transform none
      color rgba(#fff, .68)
      max-width 44ch

    .card-link
      margin-top .7rem
      font-size .84rem
      font-weight 600
      letter-spacing .01em
      color rgba(alpha + 15%, .95)
      transition color .18s ease
      opacity .95

      &::after
        content ' →'