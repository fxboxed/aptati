.letters 
    position absolute
    left .6rem
    //right 0
    top 50%
    transform translateY(-50%)
    //bottom 0
    display flex

    gap .7rem
    padding 0
    margin 0
    width 6rem
    height 6rem
    border-radius 10px
    //font-size 1.8rem !important
    overflow hidden
    //background red //rgba(alpha, .08)
    display flex  
    align-items center
    justify-content center
    // box-shadow inset 0 0 0 1px rgba(255,255,255,.06)
    

    span  
      font-size 3.4rem
      font-weight 800
      display inline-block
.letters-1
    background linear-gradient(120deg, rgba(alpha,.01) 30%, rgba(alpha,.6))
    border-right 4px solid alpha
        
.letters-2
    background linear-gradient(120deg, rgba(beta,.01) 30%, rgba(beta,.5))
    border-right 4px solid beta
    h4  
      span 
        color beta
    &::before
        width 18px
        height 18px
        border 3px solid beta
        border-radius 50%

.letters-3
    background linear-gradient(120deg, rgba(gamma,.01) 30%, rgba(gamma,.5))
    border-right 4px solid gamma
    h4 
      span 
        color gamma
    &::before
        width 18px
        height 18px
        border 3px solid gamma
        border-radius 50%


.letters-4
