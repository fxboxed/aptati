.side-nav
    position: absolute
    top: - 1rem
    left: 0
    right 0
    //width: 400px //100% !important
    height: 50px
    display: flex
    align-items: center
    //border-bottom 1px solid alpha //- 60%
    //padding: 0 20px
    z-index: 100
  

.header-liner
    display flex
    align-items center
    justify-content space-between
    align-items center
    width 100% //380px
    //max-width 420px
    height 50px
    margin 1rem auto 0
    //background green
    //padding-top 1rem
    nav.navbar
        display flex
        align-items center
        justify-content space-between
        width 100%
        background linear-gradient(90deg, rgba(alpha,.01) 30%, rgba(alpha,.3))
        height 100%
        border-radius: 1rem
        a   
            color epsilon
            height fit-content
            z-index 2
        &::after
            background  linear-gradient(60deg, rgba(epsilon, .2) 70%, rgba(epsilon, .08)) 
            content ''
            position absolute
            top 0
            left 50%
            transform translateX(-50%)
            width 98%
            height 100%
            //border-left 4px solid epsilon - 70%
            border-right 4px solid epsilon - 10%
            border-top 1px solid epsilon - 20%
            border-radius: 1rem
button.side-nav-toggle
    //background none
    position absolute
    top 1.2rem
    right 1.3rem
    border none
    cursor pointer
    display flex
    flex-direction column
    justify-content space-between
    align-items center
    width 2.5rem
    height 2.5rem
    z-index 1
    ///margin-left auto
    //background blue
    .bar
        height 20%
        width 84%
        background epsilon
        &:nth-child(2)
            width 100%
button.close-side-nav
    //background none
    position absolute
    top 0rem
    right 1rem
    border none
    cursor pointer
    display flex
    flex-direction column
    justify-content space-between
    align-items center
    width 1.5rem
    height 1.5rem
    z-index 1
    i.fas.fa-xmark
        font-size 2rem
        color epsilon - 40% !important
        position absolute
        z-index 1400
        //display none
ul.nav-bar-ul
    display flex
    flex-direction column
    align-items center
    justify-content: right
    gap .5rem
    list-style none
    margin 0
    position absolute
    transition all 0.3s ease    
    left 0
    top 0rem
    z-index 10
    bottom 1rem
    padding 5rem 1rem
    transform scale(1,0)
    transform-origin: top
    //display none
    width 100%
    height 45rem
    background alpha //linear-gradient(90deg, rgba(alpha) 30%, rgba(alpha + 40%))
    &::before
        background linear-gradient(90deg, rgba(epsilon,.01), rgba(epsilon,.5))
        content ''
        position absolute
        z-index -1
        top 0 // -15rem
        left 0 //50%
        //transform translateX(-50%)
        width 100%
        height 100%

    // &::after  
    //     content "X" 
    //     position absolute
    //     top 1.2rem
    //     right 1.3rem
    //     font-size 5rem
    //     color red //epsilon !important
    //     z-index 2 !important

    li   
        border-bottom 1px solid epsilon - 10%
        padding .4rem
    a, li.nav-item a, .contact-btn#contactToggle 
        color epsilon - 20% !important
        font-size 1.2rem
        font-weight normal
        text-decoration none
        position relative
        z-index 200
        //border-bottom 1px solid alpha - 40%
    .contact-btn#contactToggle
        padding 0
        margin 0
    li.list-heading
        color alpha + 70%
        //font-weight bold
        display block
        text-transform: uppercase
        //background epsilon - 40%
        padding .4rem 2rem
        border 1px solid epsilon - 20%
        
    &::after
        content ""
        position absolute
        top 4rem
        left 1.5rem
        right 1.5rem
        bottom 2rem
        //width calc(100% - 2rem)
        //height calc(100% - 2rem)
        border 1px solid epsilon - 40%
        z-index 01
a.logo 
    //border 1px solid #fff
    color alpha 
    font-weight bold
    line-height 1
    height 100%

// HIDE / SHOW NAV
ul.nav-bar-ul.side-nav-open
    transform scale(1)
    display flex
    //background green