.header-nav-controls
    display flex    
    gap 1rem
    align-items center
    justify-content space-between
    padding .6rem
    max-width  90%
    width 100%
    margin auto
    //background theta
    //border-bottom 1px solid green //rgba(alpha, .2)
    .contact-btn
        margin-left auto !important
        margin-right 0 !important
        color beta
        font-weight bold
        font-size 1.2rem

// classes added + removed in js
.side-nav
    position: absolute
    top: - 1rem
    left: 0
    right 0
    //width: 400px //100% !important
    height: 50px
    display: flex
    align-items: center
    //padding: 0 20px
    z-index: 100
.side-nav-open
    transform scale(1, 1)
    display flex    
    
button.side-nav-toggle
    top 0.5rem
    right 1.5rem
    cursor pointer
    display flex
    flex-direction column
    justify-content space-between
    align-items left // center
    width 2.5rem
    height 2rem

    .bar
        height 20%
        //width 88%
        //display none
        background alpha  + 40% // 
        margin-left 0
        margin-right auto
        &:nth-child(1)
            width 80%
            background delta
        &:nth-child(2)
            background delta
            width 100%
        &:nth-child(3)
            background gamma
            width 60%
button.close-side-nav
    //background none
    content "CLOSE"
    position absolute
    top 0rem
    right 1rem
    border none
    cursor pointer
    display flex
    flex-direction column
    justify-content space-between
    align-items center
    width 1.5rem
    height 1.5rem
    z-index 1
    i.fas.fa-xmark
        font-size 2rem
        color #fff !important
        position absolute
        z-index 1400
        //display none
.nav-bar-ul
    display block !important //block  !important
    flex-wrap wrap
    flex-direction column
    margin 0
    position absolute 
    left 1rem
    right 1rem
    top 1.2rem
    z-index 10
    bottom 1rem
    border-radius 1rem
    padding 5rem 1rem
    //transform scale(1, 0)
    transition: all .3s ease-in-out
    transform-origin: top left
    //display none
    list-style none
    //width 100%
    height 36rem
    background rgba(0,0,0, .2)
    li   
        //border 1px solid green //alpha - 40%// #
        flex 1
        padding .1rem
        //-width 12
        margin 0 auto //rem
        width 80% // 14rem
        overflow hidden
        line-height 1
        height fit-content
    a   
        width 100%
        justify-content: left
        //text-decoration underline
        border-bottom 1px solid rgba(alpha + 60%, .2)
        color alpha + 80%
        text-align left !important
    .custom-hr  
        span.span-2  
            color alpha + 60%
            font-size 1.2rem

     
    .contact-btn#contactToggle
        padding 0
        margin 0
    li.list-heading
        //color alpha + 70%
        margin .6rem auto 0
        //font-weight bold
        text-align center
        display block
        text-transform: uppercase
        //background epsilon - 40%
        padding .1rem 2rem
        border none
        //flex 1
        //border-bottom 1px solid alpha + 60%
        
