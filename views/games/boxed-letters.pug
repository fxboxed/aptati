extends ../layouts/main-layout
block content 
    .game-block.mg-top-2
        .guide
            p.guide-p Use all letters. First word can begin with any letter. After which the next word must start with the last letter of the previous word
    .game-block.mg-1-auto
        p.used-unused.txt-center <span class='used-letters'> Used letters </span> <span class='dot'></span> <span class='unused-letters'> Unused letters </span>
    .game-block.bl-game-block.mg-1-auto
        //- .found-words //- show list of words used so far
        .bl-words-used-box#bl-words-used-box
            p.words-used-title Words Used 
            //-  show list of words used
            #bl-word-list 

            //- a respectable number of words to use all the letters
            p.solve-in-words Solve in: <span id="bl-todays-best">(0)</span> Word(s) or less 
        //- letters used will have a class added to them
        .bl-side.top
            //- letters for the top side
            each letter, idx in ['', '', '']
                .letter-btn(data-letter=letter) A
        .bl-side.left
            //- letters for the left side
            each letter, idx in ['', '', '']
                .letter-btn(data-letter=letter)= letter
        .bl-side.right
            //- letters for the right side
            each letter, idx in ['', '', '']
                .letter-btn(data-letter=letter)= letter
        .bl-side.bottom
            //- letters for the bottom side
            each letter, idx in ['', '', '']
                .letter-btn(data-letter=letter) A