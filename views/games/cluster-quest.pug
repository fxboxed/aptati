extends ../layouts/main-layout
block content
    .game-block.mg-top-1.mg-btm-1 
        .plain-dropdown-wrap
            //- shows the below section when focused
            //- dropdown mechanism is done with css only, no js involved. the section is hidden by default and shown when the button is in focus. 
            button.toggle-btn.cq-toggle#cq-toggle VIEW THIS GAME'S CATEGORIES
            section#cq-categories-list.pad-1       
            //- the 4 categories will be loaded with the game and displayed when the above button is in focus. there is no js involve in this dropdown mechanism.each category will be in its own span generated with js and added to this section
    .game-block.pad-1 
        .words-used-wrap.mg-btm-1
            p.mg-btm-05 Words Used This Attempt
            .words-this-attempt(id=WordsThisAttempt)

        p.mg-btm-05 Categories Found <span id="cq-categories-found-count">0</span>/4
        #cq-found-categories.cq-found-categories
        //- categories found will appear here  
    .game-block.mg-top-05.mg-btm-1
        p.mg-btm-05 Words : Choose 4x4 groups
        .words-grid#cq-words-grid.pad-1

