extends ../layouts/main-layout
block content
    .game-block.mg-top-1.mg-btm-1 
        .plain-dropdown-wrap
            //- shows the below section when focused
            //- dropdown mechanism is done with css only, no js involved. the section is hidden by default and shown when the button is in focus. the categories will be loaded with the game and displayed in the section below.
            button.toggle-btn.wg-toggle#wg-toggle THIS GAME'S CATEGORIES
            section#wg-categories-list 
                span span 1 
                span span 2
                span span 3
                span span 4
                span span 5
                span span 6
            //- the 4 categories will be loaded with the game and displayed when the above button is in focus. there is no js involve in this dropdown mechanism.each category will be in its own span generated with js and added to the above section
    .game-block 
        #wg-found-categories.wg-found-categories
        //- categories found will appear here in their own span
        //- p.wg-categories-found Categories found: <span id="wg-categories-found-count">0</span>/4  
    .game-block.mg-top-1.mg-btm-1
        .words-grid#wg-words-grid
        //- the grid of words will be generated here with js. each word will be a button that can be clicked to select/deselect. the selected words will be checked against the categories to see if they belong to any of them. if they do, they will be added to the found categories section above and removed from the grid. the game ends when all 4 categories are found or when the player gives up.