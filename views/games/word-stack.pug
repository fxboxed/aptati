//- =========================================================================
//- WORD STACK PUG VIEW TEMPLATE (views/games/word-stack.pug)
//- =========================================================================
//- Renders the 6x5 interactive tile grid and virtual on-screen keyboard.
//- Extends main site layout template.

extends ../layouts/main-layout

block content
    //- Main 6x5 letter display grid
    .game-block            
        .word-grid#ws-word-grid
            each row in [0,1,2,3,4,5]
                .tile-row(data-row=row)
                    each col in [0,1,2,3,4]
                        .tile(data-row=row data-col=col)

    //- Interactive on-screen virtual keyboard
    .game-block.mg-btm-1
        .keyboard#ws-keyboard
            //- Top alphabetical key row
            .key-row
                each key in ["Q","W","E","R","T","Y","U","I","O","P"]
                    .key(data-key=key)= key

            //- Middle alphabetical key row
            .key-row
                each key in ["A","S","D","F","G","H","J","K","L"]
                    .key(data-key=key)= key

            //- Bottom key row with Enter key, Z-M letters, and Backspace key
            .key-row.enter-backspace-row
                //- 🎯 FIXED: Re-enabled the Enter key for touch/mouse users
                .key.enter(data-action="enter") ↵
                .key(data-key="Z") Z
                .key(data-key="X") X
                .key(data-key="C") C
                .key(data-key="V") V
                .key(data-key="B") B
                .key(data-key="N") N
                .key(data-key="M") M
                .key.backspace(data-action="backspace") ⌫

    //- Load isolated client-side engine script
    script(src="/js/games/word-stack/index.js" defer)