extends ../layouts/main-layout
//-  Pug view 
//- for word-stack game, which is similar to wordle. The player has 6 attempts to guess a 5 letter word. After each guess, the letters will be have a class added to indicate if they are in the correct position (ws-correct), in the word but in the wrong position (ws-present), or not in the word at all (ws-incorrect). The player can use the on-screen keyboard or their physical keyboard to make guesses. The game will also have a restart button and an answers button that reveals the correct word and optimal solutions when clicked. The game will be responsive and visually appealing, with smooth animations and transitions.
//- the answer will be provide in a span
//- 
block content
    .game-block            
        .word-grid#ws-word-grid
            each row in [0,1,2,3,4,5]
                .tile-row(data-row=row)
                    each col in [0,1,2,3,4]
                        .tile(data-row=row data-col=col)
    .game-block.mg-btm-1
        .keyboard#ws-keyboard
            .key-row
                each key in ["Q","W","E","R","T","Y","U","I","O","P"]
                    .key(data-key=key)= key
            .key-row
                each key in ["A","S","D","F","G","H","J","K","L"]
                    .key(data-key=key)= key
            .key-row.enter-backspace-row
                .key.enter(data-action="enter") ↵
                .key(data-key="Z") Z
                .key(data-key="X") X
                .key(data-key="C") C
                .key(data-key="V") V
                .key(data-key="B") B
                .key(data-key="N") N
                .key(data-key="M") M
                .key.backspace(data-action="backspace") ⌫
    script(src="/js/games/word-stack/index.js" defer)