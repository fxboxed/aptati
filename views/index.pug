extends ./layouts/main-layout
block content
    .game-block.mg-btm-3.mg-top-2
        .index-header-wrap
            h3.word-blocks.word-blocks-lg 
            span.blocks-wrap
                span.word-block.word-block-1 W
                span.word-block.word-block-2 O
                span.word-block.word-block-3 R
                span.word-block.word-block-4 D
            span.blocks-wrap
                span.word-block.word-block-1.md-block p
                span.word-block.word-block-2.md-block u
                span.word-block.word-block-3.md-block z
                span.word-block.word-block-4.md-block z
                span.word-block.word-block-1.md-block l
                span.word-block.word-block-2.md-block e
                span.word-block.word-block-3.md-block s
    .game-block.mg-btm-2 
        ul.site-info-ul.clip-front-to-backs.site-info-ul-2
            li.alpha A variety of word games to challenge your vocabulary and word-guessing skills.
            li.beta Unlimited games. Start a new game as often as you like.
            li.gamma Unlimited attempts. Restart the same game as often as you like.
            li.delta Sleek and intuitive design for a seamless gaming experience.
            li.epsilon No membership required., regardless of how many games you play.
    .game-block 
        .responsive-grid
            a.responsive-grid-item(href="/games/word-scramble")
                .img
                    img(src="/images/1x1/word-scramble-1x1.webp", alt="Preview image for Word Scramble")
                .txt
                    h3 Word Scramble
                    p.card-para A six-letter word game that tests your vocabulary and word-guessing skills.
                    span.card-link Play now

            a.responsive-grid-item(href="/games/spelling-bee")
                .img
                    img(src="/images/1x1/spell-bug-1x1.webp", alt="Preview image for Spell Bug")
                .txt
                    h3 Spell Bug
                    p.card-para Build words from a set of letters, always including one required letter.
                    span.card-link Play now

            a.responsive-grid-item(href="/games/word-groups")
                .img
                    img(src="/images/1x1/word-groups-1x1.webp", alt="Preview image for Word Groups")
                .txt
                    h3 Word Groups
                    p.card-para Sort related words into groups based on shared meanings, themes, or categories.
                    span.card-link Play now

            a.responsive-grid-item(href="/games/boxed-letters")
                .img
                    img(src="/images/1x1/letter-boxes-1x1.webp", alt="Preview image for Letter Boxes")
                .txt
                    h3 Letter Boxes
                    p.card-para Form words by linking letters within a grid while following the puzzle rules.
                    span.card-link Play now