extends ./layouts/main-layout
block head
  meta(charset="UTF-8")
  meta(name="viewport" content="width=device-width, initial-scale=1.0")
  title Aptati Games - Play Area

  //- Open Graph / Facebook Protocol
  meta(property="og:type" content="website")
  meta(property="og:title" content="Aptati Games - Play Area")
  meta(property="og:description" content="Discover more on our main site.")
  
  //- 1. The destination URL Facebook opens when the image card is clicked
  meta(property="og:url" content="https://aptati.com/")

  //- 2. The full-size preview image Facebook displays
  meta(property="og:image" content="https://aptati.com/images/church-bg.jpg")
  meta(property="og:image:secure_url" content="https://aptati.com/images/church-bg.jpg")
  meta(property="og:image:type" content="image/jpeg")
  meta(property="og:image:width" content="1200")
  meta(property="og:image:height" content="630")

  //- Twitter Card Fallback (Ensures high-quality cards on Twitter/X too)
  meta(name="twitter:card" content="summary_large_image")
  meta(name="twitter:title" content="Aptati Games - Play Area")
  meta(name="twitter:description" content="Discover more on our main site.")
  meta(name="twitter:image" content="https://aptati.com/images/church-bg.jpg")

block content
    - var currentPage = 'APTATI'
    .game-block 
        img#myImage(src="/images/church-bg.jpg" alt="Logo")
        button#copyBtn(onclick="copyImageUrl()") Copy Image URL   
        .responsive-grid
            a.responsive-grid-item.link-1(href="/games/word-stack")
                .letters.letters-1
                    h4.index-letters <span>W</span><span>S</span>
                    //- img(src="/images/1x1/word-stack-1x1.webp", alt="Preview image for Word Stack")
                        .custom-hr 

                .txt.txt-left
                    h1 APTATI WORD STACK CHALLENGE
                    //- .custom-hr 
                    //-     span.span-1 
                    //-     span.span-2
                    //-     span.span-3
                    p.card-para A five-letter word game that tests your vocabulary and word-guessing skills.
                    span.card-link Play now

    .game-block.mg-btm-2 
        .custom-hr 
            span.span-1 
            span.span-2 At A Glance
            span.span-3
    .game-block.mg-btm-2 
        ul.site-info-ul.clip-front-to-backs.site-info-ul-2
            //- li.alpha A variety of word games to challenge your vocabulary and word-guessing skills.
            li.beta Unlimited games. Start a new game as often as you like.
            li.delta Sleek and intuitive design for a seamless gaming experience.
            li.epsilon No membership required., regardless of how many games you play.


