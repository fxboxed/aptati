//- 
    mixin consumed by main-layout.pug to render header buttons in the game pages.
    The mixin takes three parameters: restart, newGame, and answers, which are the IDs for the respective buttons. This allows each game page to specify its own button IDs for event handling.
    It assigns an ID to each game's respective buttons so that the buttons can be targeted for event listeners in the client-side JavaScript for each game.
mixin headerBtn(restart, newGame, endGame)
    .game-block.header-btns-block.mg-btm-05.mg-top-2
        .header-btns.mg-top-1
            button.header-btn.header-btn-1(id=restart) RESTART
            button.header-btn.header-btn-2(id=newGame) NEW GAME
            //-  The following button will be enabled and the 6 optimal solutions will be revealed when the user clicks "End Game".
            if currentPage == 'Letter Link'
                button.header-btn.header-btn-3(id=endGame) END GAME
                .dropdown(id-=endGame)
                    h3 answers
            else  

        if currentPage != 'Letter Link'
            P.answer-reveal.mg-top-1 Click "END GAME" to reveal the answers
        //- stying for letter link appears on letter-link.styl and is different from the other games, so it is not included on this mixin's styl sheet.   
        if currentPage == 'Letter Link'
            //- the word being constructed will appear in the placeholder
            input(type="text" id=wordConstructor placeholder="Click END GAME to reveal the optimal answers below" disabled) 
            .ll-answers#ll-answers