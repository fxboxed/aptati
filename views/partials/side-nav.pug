


.header-liner.side-nav-liner
  nav.navbar
    if currentPage !== 'APTATI'
      a.logo(href="/") APTATI
    
    ul.nav-bar-ul

      li.nav-item 
        a.nav-link(href="/") Home
      if isAuthed
        //- Only show dashboard link if not on dashboard page
        if currentPage !== 'dashboard'
          li.nav-item
            a.nav-link.btn-3d(href="/dashboard")
              span.user-icon 👤
              span.user-text Dashboard
        
        li.nav-item
          form.logout-form(method="post" action="/auth/logout")
            button.logout-btn.btn-3d(type="submit") Logout
      else
        li.nav-item
          a.nav-link.login-link.btn-3d(href="/auth/google") Login
      
      li.nav-item
        button#contactToggle.contact-btn(type="button") Contact
      li.nav-item
        button#close-side-nav.close-side-nav(type="button")
          i.fas.fa-xmark
      li.list-heading Games
      li.nav-item 
        a(href="/games/the-word") The Word
      li.nav-item
        a(href="/games/spell-bug") Spell Bug
      li.nav-item
        a(href="/games/word-groups") Word Groups
      li.nav-item
        a(href="/games/boxed-letters") Boxed Letters
